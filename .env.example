# ============================================================================
# AURA LIVE — Variables de Entorno Públicas (Cliente Expo)
# IMPORTANTE: NUNCA pongas llaves secretas con el prefijo EXPO_PUBLIC_
# ============================================================================

# Supabase (Público / Cliente)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# ZegoCloud (Solo IDs públicos de aplicación y AppSign de cliente móvil)
EXPO_PUBLIC_ZEGO_APP_ID=0
EXPO_PUBLIC_ZEGO_APP_SIGN=tu-zego-app-sign
EXPO_PUBLIC_ZEGO_GAMES_APP_ID=0

# Stripe (Solo llave publicable)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_tu_llave_publicable

# ============================================================================
# SECRETOS DE SERVIDOR (Configurar en Supabase Edge Functions / Vault, NUNCA en EXPO_PUBLIC_)
# Ejecuta: supabase secrets set NOMBRE=valor
# ============================================================================
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_ANON_KEY=tu-anon-key-publica
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (Secreta — solo backend)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=AuraLive <noreply@auralive.app>
# GOOGLE_PLAY_PACKAGE_NAME=com.auralive.app
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# ZEGO_SERVER_SECRET=tu-server-secret
# ZEGO_CALLBACK_SECRET=tu-callback-secret
# ZEGO_GAMES_SERVER_SECRET=tu-games-server-secret
# ZEGO_GAMES_CALLBACK_SECRET=tu-games-callback-secret
