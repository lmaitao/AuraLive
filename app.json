{
  "expo": {
    "name": "AuraLive",
    "slug": "auralive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "auralive",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#020205"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auralive.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Aura Live requiere tu cámara para proteger la plataforma mediante biometría 3D y permitirte hacer directos.",
        "NSMicrophoneUsageDescription": "Aura Live requiere tu micrófono para que interactúes en las salas de voz y video.",
        "NSPhotoLibraryUsageDescription": "Permite acceder a tus fotos para cambiar tu avatar de perfil y compartir imágenes."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020205"
      },
      "package": "com.auralive.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./withZegoConfig.js",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Aura Live requiere tu cámara para directos y biometría."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permite acceder a fotos para avatares.",
          "savePhotosPermission": "Permite guardar fotos y videos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Aura Live requiere tu micrófono para salas de voz y directos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "extraBuildProperties": {
              "org.gradle.jvmargs": "-Xmx2048m -XX:MaxMetaspaceSize=512m"
            }
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ceb5b0e-c236-42e9-b3d7-3c4953f9e895"
      }
    }
  }
}
